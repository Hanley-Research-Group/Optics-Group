+class TestForwardMechanics:
+
+    @pytest.mark.parametrize("alpha", [0.0, 0.7, -2.0])
+    def test_single_tube_matches_closed_form(self, alpha):
+
+        l1, lc, l3, kappa = 0.05, 0.04, 0.03, 20.0
+
